# Copy this file to .env for local work. On GitHub, put the same names under
# Settings > Secrets and variables > Actions > Variables (none of these is secret).

# Public address of the site, no trailing path. Used for canonical links, the sitemap and sign-in redirects.
SITE_URL=https://michigansustainableinvestments.com

# Folder the site lives in. Leave as / for a custom domain.
# Use /msi-site/ when publishing at https://<account>.github.io/msi-site/
BASE_PATH=/

# Supabase project settings (Project settings > API). The anon key is designed to be public.
# Leave both empty to build the site without the member portal.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 to preview with obviously fake profiles and a "Preview data" banner. Never set it for the real site.
SAMPLE_DATA=
