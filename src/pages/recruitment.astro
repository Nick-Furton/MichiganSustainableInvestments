---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { club, formatDate, selectivitySentence } from '../data/club';
const selectivity = selectivitySentence();
const crumbs = [{ name: 'Recruitment', path: 'recruitment/' }];
const a = club.application;
const closes = formatDate(a.closes);
const opens = formatDate(a.opens);
let status = 'Applications are closed. Dates for the next cycle have not been announced.';
let showApply = false;
if (a.state === 'open' && closes) { status = `Applications are open until ${closes}.`; showApply = !!a.applyUrl; }
else if (a.state === 'scheduled' && opens) status = `Applications open ${opens}.`;
---
<Base
  path="recruitment/"
  crumbs={crumbs}
  title="Recruitment | Michigan Sustainable Investments"
  description="How to join Michigan Sustainable Investments (MSI) at the University of Michigan. Membership is by application."
>
  <PageHead title="Recruitment" lead="Membership is by application.">
    {selectivity && <p class="lead selectivity">{selectivity}</p>}
  </PageHead>
  <section class="section-tight">
    <div class="wrap">
      <div class="status-block">
        <p>{status}</p>
        {showApply && <a class="btn btn-dark" href={a.applyUrl}>Apply now</a>}
      </div>
    </div>
  </section>
  {club.dues && (
    <section class="section-tight">
      <div class="wrap prose">
        <h2>Dues</h2>
        <p>{`${club.dues}.`}</p>
      </div>
    </section>
  )}
</Base>
