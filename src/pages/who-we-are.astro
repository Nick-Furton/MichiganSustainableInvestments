---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { club, numberWord, listAnd } from '../data/club';
const crumbs = [{ name: 'Who We Are', path: 'who-we-are/' }];
const sym = club.symposium;
// Each fact is said once. The club's former name and the year it was renamed are in the footer.
---
<Base
  path="who-we-are/"
  crumbs={crumbs}
  title="Who We Are | Michigan Sustainable Investments"
  description="Michigan Sustainable Investments (MSI) is the student-run sustainable investing club at the University of Michigan. What the club does and how its program works."
>
  <PageHead title="Who we are" lead="Michigan Sustainable Investments (MSI) is the sustainable investing club at the University of Michigan. It was founded in 2019 and is run entirely by students." />
  <section class="section-tight">
    <div class="wrap prose">
      <h2>What we do</h2>
      <p>MSI teaches undergraduates how capital is allocated when return and impact both count. Members study public equities, green bonds, venture capital, microfinance and clean-energy finance. They hear directly from people who invest for a living.</p>
      <h2>The program</h2>
      <h3>Investing education</h3>
      <p>Modules cover how investors evaluate a deal for financial return and for impact.</p>
      <h3>Hands-on projects</h3>
      <p>Members apply the material in team projects and present their work to the club.</p>
      <h3>Professional development</h3>
      <p>Sessions cover finance recruiting: building a résumé, networking and interviewing.</p>
      <h3>Speakers and the Symposium</h3>
      <p>
        {`MSI hosts investors and operators on campus. Its symposium ran ${numberWord(sym.count)} times between ${sym.firstYear} and ${sym.lastYear}`}{club.speakerFirms.length > 0 ? `, with speakers from ${listAnd(club.speakerFirms)}.` : '.'}
      </p>
    </div>
  </section>
</Base>
