---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib/url';
const crumbs = [{ name: 'Sustainable investing', path: 'sustainable-investing/' }];

// The five kinds of investment. Each has the same four labelled parts; two also have an "On record" line.
const types = [
  {
    id: 'microfinance',
    title: 'Microfinance',
    how: `Microfinance provides small loans, savings accounts and insurance to people that banks do not serve. A loan can be a few hundred dollars. It might pay for a market stall, livestock or a sewing machine.`,
    paid: `Investors fund the lenders, by lending to them or buying a stake in them. They are repaid from borrowers' loan payments.`,
    does: `Households can start a business, cover an emergency or pay school fees without turning to a moneylender. Some lenders finance clean technology directly, such as solar home systems paid off in small instalments.`,
    examine: `Research finds that the average gain in household income is modest. Members study which interest rates and repayment terms help borrowers.`,
    record: `Muhammad Yunus and Grameen Bank shared the 2006 Nobel Peace Prize for their work on microcredit.`,
  },
  {
    id: 'impact-venture-capital',
    title: 'Venture capital for social enterprises',
    how: `Venture capital buys an ownership stake in a young company. Impact venture funds back companies whose product addresses a social or environmental problem: cheaper clean energy, access to health care, lower-cost education.`,
    paid: `The fund earns its return when the company grows and is sold or lists on a stock exchange.`,
    does: `The goal is built into the product, so the company's sales and its impact grow together.`,
    examine: `How funds measure results alongside revenue: tonnes of emissions avoided, patients reached, households served.`,
  },
  {
    id: 'green-bonds',
    title: 'Green bonds',
    how: `A green bond is a loan to a company, bank or government. The proceeds are reserved for environmental projects such as renewable power, energy-efficient buildings, clean transport and water systems. Bonds that fund climate projects are also called climate bonds.`,
    paid: `Investors receive interest and get their principal back at maturity, as with any bond.`,
    does: `Green bonds let large investors, such as pension funds, finance low-carbon projects at scale.`,
    examine: `How the issuer reports its spending. Most follow the Green Bond Principles, a voluntary standard first published in 2014.`,
    record: `The European Investment Bank issued the first green bond, its Climate Awareness Bond, in 2007. The World Bank followed in 2008.`,
  },
  {
    id: 'esg-equities',
    title: 'Public equities with high ESG ratings',
    how: `Public equities are shares of companies listed on a stock exchange. ESG stands for environmental, social and governance: how a company handles emissions and resources, its workers and communities, and its own oversight. Rating firms such as MSCI and Sustainalytics score companies on these factors.`,
    paid: `Through share price gains and dividends, as with any stock.`,
    does: `Investors direct capital toward companies that manage these risks well, and use their votes as shareholders to press for change.`,
    examine: `Ratings from different providers often disagree. Members read the underlying data instead of relying on a single score.`,
  },
  {
    id: 'clean-energy-finance',
    title: 'Clean-energy finance',
    how: `Wind farms, solar plants and battery storage need most of their money up front. Banks and investors supply it through project finance: loans repaid from the electricity the project sells, often under a long-term contract called a power purchase agreement.`,
    paid: `Lenders earn interest from the project's revenue. Equity investors receive what remains after the debt is paid.`,
    does: `Each project that is built adds clean generation to the grid.`,
    examine: `How a project's contracts, costs and financing fit together. This is the work of energy transition, renewables and power and utilities groups at investment banks.`,
  },
];
const labels: [keyof (typeof types)[number], string][] = [
  ['how', 'How it works'],
  ['paid', 'How investors are paid'],
  ['does', 'What it does'],
  ['examine', 'What members examine'],
];
const sources = [
  { text: 'Nobel Peace Prize 2006: Muhammad Yunus and Grameen Bank', href: 'https://www.nobelprize.org/prizes/peace/2006/summary/' },
  { text: 'Green Bond Principles, International Capital Market Association', href: 'https://www.icmagroup.org/sustainable-finance/the-principles-guidelines-and-handbooks/green-bond-principles-gbp/' },
  { text: 'World Bank green bonds', href: 'https://treasury.worldbank.org/en/about/unit/treasury/ibrd/ibrd-green-bonds' },
];
---
<Base
  path="sustainable-investing/"
  crumbs={crumbs}
  title="Types of sustainable investment | Michigan Sustainable Investments"
  description="How five kinds of sustainable investment work and what each one finances: microfinance, impact venture capital, green bonds, ESG equities and clean-energy finance."
>
  <PageHead title="Types of sustainable investment" lead="Sustainable investing puts money to work for a financial return and for a measurable benefit to people or the planet. Members of Michigan Sustainable Investments (MSI) study five kinds." crumbs={crumbs}>
    <nav class="type-nav" aria-label="On this page">
      <ol>
        {types.map((t, i) => <li><a href={`#${t.id}`}><span class="type-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{t.title}</a></li>)}
      </ol>
    </nav>
  </PageHead>

  <div class="types">
    {types.map((t, i) => (
      <section class="type band-alt">
        <div class="wrap type-grid">
          <div class="type-head">
            <span class="type-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h2 id={t.id}>{t.title}</h2>
          </div>
          <div class="type-body">
            <dl class="parts">
              {labels.map(([key, label]) => (
                <div class="part">
                  <dt>{label}</dt>
                  <dd>{t[key]}</dd>
                </div>
              ))}
            </dl>
            {t.record && <p class="record"><span class="record-label">On record</span>{t.record}</p>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <h2>Where this leads</h2>
        <p style="margin-top:20px">These five areas map to careers in investment banking, capital markets, asset management and impact investing.</p>
        <p><a class="arrow-link" href={url('program/#careers')}>See the careers MSI prepares members for →</a></p>
      </div>
      <div class="card reveal">
        <h2 style="font-size:28px">Sources</h2>
        <ul class="sources">
          {sources.map((s) => <li><a href={s.href} rel="noopener">{s.text}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
