---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
const crumbs = [{ name: 'Résumé and LinkedIn guide', path: 'members/resume-guide/' }];
const template = `Michigan Sustainable Investments (MSI), University of Michigan        [Start] – [End]
[Your title]
• [What you analyzed or built, with a number]
• [What you presented, and to whom]
• [What you led or organized, with its size]`;
---
<Base
  path="members/resume-guide/"
  crumbs={crumbs}
  title="How to list MSI on your résumé and LinkedIn | Michigan Sustainable Investments"
  description="The exact name, format and wording members of Michigan Sustainable Investments (MSI) should use on résumés and LinkedIn."
>
  <PageHead title="How to list MSI on your résumé and LinkedIn" lead="Use the same name everywhere. Recruiters, and the software that screens résumés, match on exact text." crumbs={crumbs} />
  <section class="section-tight">
    <div class="wrap prose">
      <h2>The name</h2>
      <p class="copy-block">Michigan Sustainable Investments (MSI), University of Michigan</p>
      <p>Write it out in full. "MSI" alone is ambiguous: at Michigan it also means a School of Information degree.</p>

      <h2>On your résumé</h2>
      <pre class="copy-block" tabindex="0" aria-label="Résumé template">{template}</pre>
      <ul>
        <li>Start each bullet with what you did.</li>
        <li>Put one number in each bullet.</li>
        <li>Name the instrument or sector you worked on.</li>
      </ul>

      <h2>On LinkedIn</h2>
      <p>Add MSI under Experience and choose the club's LinkedIn page from the list, so the entry links to MSI.</p>
      <p>Use your exact title. Board titles are set by the club.</p>

      <h2>One-line description</h2>
      <p>If you have room, add: "Student-run sustainable investing club at the University of Michigan, founded 2019."</p>

      <h2>What to avoid</h2>
      <ul>
        <li>A title you did not hold.</li>
        <li>Numbers you cannot explain in an interview.</li>
        <li>Abbreviating the club's name.</li>
      </ul>
    </div>
  </section>
</Base>
