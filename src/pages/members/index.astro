---
import Base from '../../layouts/Base.astro';
import PortalStates from '../../components/PortalStates.astro';
import { url } from '../../lib/url';
---
<Base
  path="members/"
  crumbs={[{ name: 'Member sign-in', path: 'members/' }]}
  noindex
  title="Member sign-in | Michigan Sustainable Investments"
  description="Sign in to Michigan Sustainable Investments (MSI) with your University of Michigan Google account to create or update your member profile."
>
  <!-- Visitors see one button and nothing else; the heading is for screen readers only. -->
  <section class="section-tight portal-section signin-only">
    <div class="wrap portal">
      <h1 class="sr-only">Member sign-in</h1>
      <div id="msg" class="notice" role="alert" hidden></div>
      <PortalStates signInHere />
      <div data-state="ready" hidden>
        <div class="btn-row">
          <a class="btn btn-dark" href={url('members/profile/')}>Your profile</a>
          <a class="btn btn-outline" id="link-admin" href={url('members/admin/')} hidden>Board admin</a>
          <button class="btn btn-outline" type="button" id="btn-signout">Sign out</button>
        </div>
      </div>
    </div>
  </section>
  <script>import '../../scripts/portal/signin';</script>
</Base>
