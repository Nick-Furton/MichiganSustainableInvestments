---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/placeholder/presenting-hero.jpg';
import { url } from '../lib/url';
import { getNav } from '../lib/nav';
import { contactReady } from '../lib/contact';

// The home page is one screen: the photo, the name, one line, and links to the four sections.
// It has no site header or footer and is sized to fit the window without scrolling.
// Everything else lives on the section pages.
const nav = await getNav();
// The second button is Contact us once the contact form is installed; member sign-in then moves to the small print.
const contact = contactReady();
const photoAlt = 'A presenter in a dark suit points to a slide while an audience looks on.';
---
<Base
  path=""
  bare
  bodyClass="landing-page"
  title="Michigan Sustainable Investments (MSI) | University of Michigan"
  description="Michigan Sustainable Investments (MSI) is the student-run sustainable investing club at the University of Michigan. Founded in 2019. Membership by application."
>
  <div class="landing">
    <figure class="landing-photo">
      <Picture src={hero} alt={photoAlt} formats={['avif', 'webp']} widths={[480, 720, 960, 1280, 1600]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" fetchpriority="high" decoding="async" />
    </figure>
    <div class="landing-panel">
      <div class="landing-brand">
        <svg class="landing-mark" viewBox="2 0 62 58" width="64" height="60" aria-hidden="true" focusable="false">
          <path d="M8 52 L22 22 L33 40 L46 14 L56 34" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M46 13 C46 5 52 1 61 1 C61 10 55 13 46 13 Z" fill="#ffcb05" />
        </svg>
        <h1>Michigan <span class="hl">Sustainable</span> Investments</h1>
        <p class="landing-sub">at the University of Michigan</p>
      </div>
      <div class="landing-body">
        <p class="landing-lead">Welcome to MSI, Michigan's sustainable investing club. Members prepare for careers in investment banking, private equity and asset management.</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={url('recruitment/')}>Apply</a>
          {contact
            ? <a class="btn btn-outline" href={url('contact/')}>Contact us</a>
            : <a class="btn btn-outline" href={url('members/')}>Member sign-in</a>}
        </div>
        <nav class="landing-nav" aria-label="Main">
          <ul>
            {nav.map((i) => (
              <li>
                <a href={url(i.path)}>
                  <span>{i.label}</span>
                  <svg class="landing-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="landing-legal">MSI is a student organization at the University of Michigan and is not an official unit of the University. Nothing on this site is investment advice. {contact && <><a href={url('members/')}>Member sign-in</a> · </>}<a href={url('privacy/')}>Privacy</a></p>
    </div>
  </div>
</Base>
