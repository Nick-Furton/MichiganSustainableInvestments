---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Person from '../components/Person.astro';
import { url, abs } from '../lib/url';
import { club } from '../data/club';
import { loadMembers, boardRoles } from '../lib/members';
const m = await loadMembers();
const crumbs = [{ name: 'Leadership', path: 'leadership/' }];
// Each role is named once. People who share a title (co-presidents, co-VPs) appear together under it.
const roles = boardRoles(m.profiles);
const board = roles.flatMap((r) => r.people);
const rest = m.profiles.filter((p) => !(p.board_title && p.board_title.trim()));
const people = board.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.full_name,
  jobTitle: p.board_title,
  memberOf: { '@type': 'Organization', name: club.name, url: abs('') },
  ...(p.headshot_url ? { image: abs(p.headshot_url) } : {}),
  ...(p.linkedin_url ? { sameAs: [p.linkedin_url] } : {}),
}));
---
<Base
  path="leadership/"
  crumbs={crumbs}
  noindex={m.profiles.length === 0}
  jsonLd={people}
  title="Leadership | Michigan Sustainable Investments"
  description="The executive board of Michigan Sustainable Investments (MSI) at the University of Michigan: the students who run the club, with their roles and class years."
>
  <PageHead title="Leadership" />
  <section class="section-tight">
    <div class="wrap">
      {m.profiles.length === 0 && (
        <div class="empty">
          <p>Board profiles are being added. Members can sign in to add theirs.</p>
          <a class="arrow-link" href={url('members/')}>Member sign-in →</a>
        </div>
      )}
      {roles.length > 0 && (
        <div class="roles">
          {roles.map((r) => (
            <section class={`role role-${Math.min(r.people.length, 3)}`}>
              <h2>{r.title}</h2>
              <div class="role-people">{r.people.map((p) => <Person p={p} level={3} />)}</div>
            </section>
          ))}
        </div>
      )}
      {rest.length > 0 && (
        <>
          <h2 class="members-title">Members</h2>
          <div class="grid-4">{rest.map((p) => <Person p={p} small />)}</div>
        </>
      )}
    </div>
  </section>
</Base>
