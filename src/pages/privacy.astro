---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { club } from '../data/club';
import { url } from '../lib/url';
import { contactReady } from '../lib/contact';
const contact = contactReady();
const crumbs = [{ name: 'Privacy', path: 'privacy/' }];
---
<Base
  path="privacy/"
  crumbs={crumbs}
  title="Privacy | Michigan Sustainable Investments"
  description="What Michigan Sustainable Investments (MSI) collects from members, why, who sees it, where it is stored, how sign-in works and how to delete a profile."
>
  <PageHead title="Privacy" crumbs={crumbs} />
  <section class="section-tight">
    <div class="wrap prose">
      <h2>What we collect</h2>
      <p>Members who create a profile give us their name, University of Michigan email, class year, major, LinkedIn URL, headshot, short bio and placements.</p>
      <h2>Why</h2>
      <p>We use it to publish the Leadership and Placements pages and to manage the club roster.</p>
      <h2>Who sees it</h2>
      <p>The member and board administrators see the full profile. The public sees only the fields the member chose to publish, after the board approves the profile.</p>
      <h2>Where it is stored</h2>
      <p>In the club's hosted database.</p>
      <h2>Sign-in</h2>
      <p>Sign-in uses Google and is limited to basic profile and email.</p>
      <h2>Deletion</h2>
      <p>Members can delete their profile at any time from the profile page. Deleting it removes it from the next site update.</p>
      {contact && (
        <>
          <h2>Contact form</h2>
          <p>The contact form stores your name, email address, organization (if you give one) and your message. Only the board can read it. The board deletes a message on request.</p>
        </>
      )}
      <h2>Contact</h2>
      {club.contactEmail
        ? <p><a href={`mailto:${club.contactEmail}`}>{club.contactEmail}</a></p>
        : contact
          ? <p>Use the <a href={url('contact/')}>contact form</a>.</p>
          : <p>Contact details will be posted here.</p>}
    </div>
  </section>
</Base>
