---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PlacementList from '../components/PlacementList.astro';
import { url } from '../lib/url';
import { loadMembers } from '../lib/members';
import { firmWall } from '../lib/firms';
const m = await loadMembers();
const crumbs = [{ name: 'Placements', path: 'placements/' }];
const years = [...new Set(m.placements.map((p) => p.year))].sort((a, b) => b - a);
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base
  path="placements/"
  crumbs={crumbs}
  title="Placements | Michigan Sustainable Investments"
  description="Firms where alumni of Michigan Sustainable Investments (MSI) have worked, in investment banking, private equity and asset management."
>
  <PageHead title="Placements" lead="MSI alumni have gone on to work at these firms." crumbs={crumbs} />
  <section class="section-tight">
    <div class="wrap">
      {firmWall.map((g) => (
        <div class="firm-group">
          <h2>{g.title}</h2>
          <ul class="firm-wall">
            {g.firms.map((f) => (
              <li class="firm-tile">
                {f.src
                  ? <img src={url(f.src)} alt={f.name} width={f.w} height={f.h} style={`--w:${f.w}px`} loading="lazy" decoding="async" />
                  : <span class="firm-name">{f.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="small firm-note">Firm names and logos identify employers only. They are trademarks of their owners and do not imply sponsorship or endorsement.</p>
    </div>
  </section>
  {m.placements.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <h2 class="offers-title">Offers by year</h2>
        {years.map((y) => (
          <div class="year-group">
            <h3>{y}</h3>
            <PlacementList items={m.placements.filter((p) => p.year === y)} />
          </div>
        ))}
        <p class="small">{`Updated ${updated}.`}</p>
      </div>
    </section>
  )}
  <section class="section-tight">
    <div class="wrap prose">
      <h2 id="careers">Careers members prepare for</h2>
      <p>Sustainable finance is now a line of business at banks, asset managers and funds. Members use MSI to prepare for roles in:</p>
      <ul>
        <li><strong>Investment banking.</strong> Energy transition, renewables, and power and utilities groups advise on and finance the build-out of clean power.</li>
        <li><strong>Sustainable finance and capital markets.</strong> Desks that structure green and sustainability-linked bonds.</li>
        <li><strong>Asset management and research.</strong> Funds and analysts that weigh environmental, social and governance factors in public markets.</li>
        <li><strong>Impact investing and venture capital.</strong> Funds that back companies with a measurable social or environmental goal.</li>
      </ul>
    </div>
  </section>
</Base>
