---
// State panels shared by the three members pages. The script shows exactly one (data-state).
// Without JavaScript the "signedout" panel (or "unconfigured") stays visible.
import { url } from '../lib/url';
import { portalConfigured } from '../lib/members';
const configured = portalConfigured();
interface Props { signInHere?: boolean }
const { signInHere = false } = Astro.props;
---
<div data-state="unconfigured" hidden={configured}>
  <p class="notice">Member sign-in is not switched on yet.</p>
</div>
<div data-state="signedout" hidden={!configured}>
  {signInHere ? (
    <p><button class="btn btn-dark" type="button" id="btn-signin">Sign in / Create account</button></p>
  ) : (
    <p><a class="btn btn-dark" href={url('members/')}>Sign in / Create account</a></p>
  )}
</div>
<div data-state="wrongdomain" hidden>
  <p class="notice error">Use your @umich.edu account.</p>
  <p><a class="btn btn-dark" href={url('members/')}>Try again</a> <button class="btn btn-outline" type="button" id="btn-signout-wrong" data-signout>Sign out</button></p>
</div>
