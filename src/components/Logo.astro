---
// Original club mark: three ascending rounded bars, the tallest topped by a small maize circle, beside the wordmark.
import { url } from '../lib/url';
interface Props { light?: boolean; link?: boolean }
const { light = false, link = true } = Astro.props;
const bar = light ? '#ffffff' : '#0b1f3a';
---
{link ? (
  <a class="logo" href={url('')}>
    <svg class="logo-mark" viewBox="0 0 48 52" width="40" height="43" aria-hidden="true" focusable="false">
      <rect x="4" y="38" width="10" height="12" rx="5" fill={bar} />
      <rect x="19" y="26" width="10" height="24" rx="5" fill={bar} />
      <rect x="34" y="14" width="10" height="36" rx="5" fill={bar} />
      <circle cx="39" cy="6" r="5" fill="#ffcb05" />
    </svg>
    <span class="logo-word"><span>Michigan</span> <span>Sustainable Investments</span></span>
  </a>
) : (
  <span class="logo">
    <svg class="logo-mark" viewBox="0 0 48 52" width="40" height="43" aria-hidden="true" focusable="false">
      <rect x="4" y="38" width="10" height="12" rx="5" fill={bar} />
      <rect x="19" y="26" width="10" height="24" rx="5" fill={bar} />
      <rect x="34" y="14" width="10" height="36" rx="5" fill={bar} />
      <circle cx="39" cy="6" r="5" fill="#ffcb05" />
    </svg>
    <span class="logo-word"><span>Michigan</span> <span>Sustainable Investments</span></span>
  </span>
)}
