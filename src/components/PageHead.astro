---
import { url } from '../lib/url';
interface Props { title: string; lead?: string; crumbs?: { name: string; path: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---
<section class="page-head">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={url('')}>Home</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={url(c.path)}>{c.name}</a>}</li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
