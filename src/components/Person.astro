---
import type { PublicProfile } from '../lib/members';
import { url } from '../lib/url';
interface Props { p: PublicProfile; small?: boolean; level?: 2 | 3 }
const { p, small = false, level = 3 } = Astro.props;
const Name = `h${level}` as 'h2' | 'h3';
const initials = p.full_name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const hue = [...p.full_name].reduce((a, c) => a + c.charCodeAt(0), 0) % 4;
const bgs = ['#0b1f3a', '#14315a', '#1d3f6e', '#243a52'];
const w = p.headshot_width ?? 800;
const srcset = p.headshot_url && p.headshot_small_url ? `${url(p.headshot_small_url)} 600w, ${url(p.headshot_url)} ${w}w` : undefined;
const sizes = srcset ? (small ? '(max-width: 700px) 46vw, 280px' : '(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 420px') : undefined;
// The school is not shown: class year and major only.
const meta = [p.class_year ? `Class of ${p.class_year}` : '', p.major ?? ''].filter(Boolean);
---
<article class:list={['person', { 'person-small': small }]}>
  <div class="person-photo">
    {p.headshot_url
      ? <img src={url(p.headshot_url)} srcset={srcset} sizes={sizes} alt={`Headshot of ${p.full_name}`} width={w} height={w} loading="lazy" decoding="async" />
      : <svg viewBox="0 0 200 200" role="img" aria-label={`Initials avatar for ${p.full_name}`}><rect width="200" height="200" fill={bgs[hue]} /><text x="100" y="118" text-anchor="middle" font-family="Inter Variable, Inter, Arial, sans-serif" font-size="72" font-weight="600" fill="#ffcb05">{initials}</text></svg>}
  </div>
  <div class="person-body">
    <Name class="person-name">{p.full_name}</Name>
    {p.board_title && <p class="person-title">{p.board_title}</p>}
    {meta.map((m) => <p>{m}</p>)}
    {p.linkedin_url && <p><a href={p.linkedin_url} rel="noopener nofollow">LinkedIn<span class="sr"> profile of {p.full_name}</span></a></p>}
  </div>
</article>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
